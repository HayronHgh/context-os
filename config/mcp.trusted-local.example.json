{
  "schemaVersion": 1,
  "projectRoot": "../workspace",
  "mode": "trusted-local",
  "maximumResourceBytes": 131072,
  "artifactPolicy": {
    "artifactPersistenceChars": 800,
    "maxToolOutputChars": 12000,
    "staleToolCompressionChars": 800,
    "staleToolPreviewChars": 500
  },
  "security": {
    "allowCommands": false,
    "commandTimeoutSeconds": 120
  }
}
